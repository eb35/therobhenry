---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RecentPosts from '../components/RecentPosts.astro';
import heroImage from '../assets/hero-homepage.jpeg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-image">
				<Image
					src={heroImage}
					width={720}
					height={402}
					alt=""
					loading="eager"
					fetchpriority="high"
					densities={[1.5, 2]}
				/>
			</div>
			<h1>Yes, <em>the</em> Rob Henry.</h1>
			<p>
				I'm a web developer whose passionate about technology and short on time and content. 
				What you'll find here is a collection of things that I find interesting or amusing.
			</p>
			<RecentPosts />
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-image {
		margin: 0 0 1.5em;
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
</style>
